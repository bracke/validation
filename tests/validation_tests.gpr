with "config/validation_tests_config.gpr";
project Validation_Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Validation_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use Validation_Tests_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Validation_Tests;
