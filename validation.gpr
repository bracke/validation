with "config/validation_config.gpr";
project Validation is

   for Library_Name use "Validation";
   for Library_Version use Project'Library_Name & ".so." & Validation_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Validation_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("VALIDATION_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      --  Ada 2022, wide lines (-gnatyM120), extensions (-gnatX), and runtime
      --  assertions/contracts enabled in development (-gnata) so the invariant
      --  contracts in VAL-INV-* are actually checked. Release profile drops
      --  -gnata via the config switch set.
      for Default_Switches ("Ada") use Validation_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Validation;
